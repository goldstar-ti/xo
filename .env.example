# Copy to .env (mode 600) and fill in. Keep .env out of git. See docs/RUNBOOK.md.

# PostgreSQL in the xo-db container. Compose builds DATABASE_URL from these.
# Use a hex or URL-safe password: it goes into a URL unencoded.
POSTGRES_DB=xo_db
POSTGRES_USER=xo_user
POSTGRES_PASSWORD=

# Paste the three lines printed once by:
#   docker compose run --rm --no-deps app python scripts/gen_keys.py
SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Contact for the push services: XO's own address (no email address needed).
VAPID_SUBJECT=https://xo.tifunction.com

# Leave true: the site is HTTPS through Cloudflare.
COOKIE_SECURE=true

# Log level for the JSON logs (DEBUG, INFO, WARNING, ERROR). Default INFO.
# LOG_LEVEL=INFO

TZ=Australia/Perth

# NOBBIE's tracker, read-only, on the Tracker screen. Leave blank to turn it off.
# A NOBBIE account that can open the tracker; XO only reads.
NOBBIE_URL=
NOBBIE_USER=
NOBBIE_PASSWORD=
