# Copy to .env and fill in. Keep .env out of git.

# PostgreSQL on GS-SV-008 (see README step 1)
DATABASE_URL=postgresql+asyncpg://xo:CHANGE_THIS_PASSWORD@localhost:5432/xo

# Paste the three lines printed by: docker compose run --rm xo python scripts/gen_keys.py
SECRET_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# A contact address the push services can use if something goes wrong with your notifications
VAPID_SUBJECT=mailto:you@example.com

# Leave true behind Cloudflare (HTTPS). Only set false for plain-http testing on your own machine.
COOKIE_SECURE=true
